# === 기본 설정 ===
NODE_ENV=production
PORT=3001

# === 보안 (필수 — 반드시 변경) ===
JWT_SECRET=change-this-to-a-secure-random-string
ENCRYPTION_KEY=change-this-32-byte-hex-key
IP_SALT=change-this-to-random-salt

# === 사이트 URL (배포 후 실제 도메인으로 변경) ===
SITE_URL=https://your-domain.com
BASE_URL=https://your-domain.com

# === 카페24 연동 ===
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=https://your-domain.com/api/integrations/cafe24/oauth/callback

# === 정산 ===
PAYOUT_PROVIDER=
PAYOUT_API_KEY=
PAYOUT_API_SECRET=
SETTLEMENT_MIN_AMOUNT=5000
ATTRIBUTION_WINDOW_DAYS=30
